# Copy to .env at the repository root:  cp .env.example .env
# Every variable here is server-only. Never prefix secrets with NEXT_PUBLIC_.

# PostgreSQL (matches infra/docker/compose.yml)
DATABASE_URL="postgresql://branch:branch@localhost:5432/branch"
# Used by integration and end-to-end tests; must point at a disposable database.
TEST_DATABASE_URL="postgresql://branch:branch@localhost:5432/branch_test"

# Better Auth. Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app (used for callbacks and cookie security).
BETTER_AUTH_URL="http://localhost:3000"

# Optional GitHub sign-in. Leave both blank to disable. Create an OAuth app at
# https://github.com/settings/developers with callback URL  <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional Google sign-in. Leave both blank to disable. Create an OAuth client ID (type "Web
# application") in Google Cloud Console with redirect URI  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional locally. Vercel sends it to the daily job (/api/cron/daily) that counts synced
# submissions whose problem was added and deletes ones still waiting after 30 days. Generate with:
#   openssl rand -base64 32
CRON_SECRET=""

# Shown on the public privacy policy (/privacy) for questions and account deletion requests.
# Required before publishing the Chrome extension.
PRIVACY_CONTACT_EMAIL=""

# The extension's Chrome Web Store page (https://chromewebstore.google.com/detail/...). Settings
# shows "Get the extension" once it's set; until then it says the extension is coming soon.
EXTENSION_STORE_URL=""

# Branch's code analyzer (services/analyzer), deployed as its own Vercel project. Optional: without
# it, solutions aren't analyzed. Both or neither; the same secret goes in the analyzer project's
# ANALYZER_SECRET. Locally: `pnpm analyzer:dev` serves it at http://localhost:8787. Generate the
# secret with:  openssl rand -base64 32
ANALYZER_URL=""
ANALYZER_SECRET=""

# New accounts sign up with Google or GitHub. "true" also allows password sign-ups: for local
# development and tests only. With no Google or GitHub keys set, password sign-up stays on.
PASSWORD_SIGN_UP="true"
