{
  "name": "branch",
  "private": true,
  "description": "Branch \u2014 Grow together. Solve better.",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @branch/web dev",
    "build": "pnpm --filter @branch/web build && pnpm --filter @branch/web budget",
    "start": "pnpm --filter @branch/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @branch/extension build:e2e && pnpm --filter @branch/web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:analyzer && pnpm test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker/compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker/compose.yml down",
    "db:generate": "pnpm --filter @branch/database generate",
    "db:migrate": "pnpm --filter @branch/database migrate:dev",
    "db:deploy": "pnpm --filter @branch/database migrate:deploy",
    "db:reset": "pnpm --filter @branch/database migrate:reset",
    "db:studio": "pnpm --filter @branch/database studio",
    "test:integration": "pnpm --filter @branch/web test:integration",
    "db:seed": "pnpm --filter @branch/database seed",
    "db:import-curated": "pnpm --filter @branch/database import-curated",
    "auth:reset-link": "pnpm --filter @branch/database reset-link",
    "db:load-curated": "pnpm db:import-curated -- --catalog prisma/data/catalog.json prisma/data/roadmaps/patterns-150.json prisma/data/roadmaps/essentials-75.json",
    "build:extension": "pnpm --filter @branch/extension build",
    "test:analyzer": "uv run --directory services/analyzer pytest -q",
    "analyzer:dev": "uv run --directory services/analyzer --env-file ../../.env uvicorn app:app --port 8787 --reload",
    "errors": "pnpm --filter @branch/database errors"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "overrides": {
      "zod@<4.6.6": ">=4.6.7"
    }
  }
}
