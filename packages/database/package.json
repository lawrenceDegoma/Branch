{
  "name": "@branch/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog-import": "./src/catalog-import.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev && prisma generate",
