// Branch database schema.
// Models are added milestone by milestone; see README.md for migration commands.
// Constraints Prisma cannot express (CHECK, partial unique indexes) live in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Authentication (Better Auth 1.7). Generated with `npx auth@1.7.15 generate`; keep the shape in
// sync when upgrading Better Auth. Domain data never goes on these models.
// ---------------------------------------------------------------------------------------------

model User {
  id               String                @id
  name             String
  email            String
  emailVerified    Boolean               @default(false)
  image            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sessions         Session[]
  accounts         Account[]
  // Branch relations (back-references only; no domain columns on this table).
  profile          Profile?
  memberships      GroupMembership[]
  groupsCreated    Group[]               @relation("GroupCreatedBy")
  invitesCreated   GroupInvite[]
  auditEventsActed GroupAuditEvent[]     @relation("AuditActor")
  auditEventsAbout GroupAuditEvent[]     @relation("AuditSubject")
  problemsAdded    Problem[]
  roadmapsOwned    Roadmap[]
  plansCreated     GroupRoadmapPlan[]
  completions      ProblemCompletion[]
  posts            Post[]
  reactions        Reaction[]
  comments         Comment[]
  extensionLinks   ExtensionConnection[]
  submissions      Submission[]
  reviewAttempts   ReviewAttempt[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ---------------------------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------------------------

enum Appearance {
  SYSTEM
  LIGHT
  DARK
}

/// Branch-owned profile, created during onboarding. A signed-in user without one is sent to
/// onboarding before using the app.
model Profile {
  userId      String     @id
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lowercase handle, 3-30 characters (CHECK constraint in migration).
  username    String     @unique
  /// At most 280 characters (CHECK constraint in migration).
  bio         String?
  /// IANA timezone name, validated by the application.
  timezone    String
  appearance  Appearance @default(SYSTEM)
  /// Post automatically when solving a problem a group's plan assigns, finishing a week, or
  /// finishing a plan. Off by default: completion never implies sharing.
  shareSolves Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("profile")
}

// ---------------------------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------------------------

enum GroupRole {
  ADMIN
  MEMBER
}

/// A private, invite-only group. Week boundaries for its plan use `timezone`.
model Group {
  id          String             @id @default(uuid(7)) @db.Uuid
  /// 1-60 characters (CHECK).
  name        String
  /// At most 280 characters (CHECK).
  description String?
  /// IANA timezone name, validated by the application.
  timezone    String
  createdById String?
  createdBy   User?              @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships GroupMembership[]
  invites     GroupInvite[]
  auditEvents GroupAuditEvent[]
  plans       GroupRoadmapPlan[]
  posts       Post[]

  @@map("group")
}

/// Exactly one ADMIN per group: at most one is enforced by a partial unique index; the service
/// layer keeps it at exactly one (transfer before leaving, transfer is one transaction).
model GroupMembership {
  groupId  String    @db.Uuid
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_membership")
}

/// Link invite. Only a SHA-256 hash of the token is stored.
model GroupInvite {
  id          String    @id @default(uuid(7)) @db.Uuid
  groupId     String    @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  /// Null means unlimited. CHECK: positive, and useCount never exceeds it.
  maxUses     Int?
  useCount    Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([groupId])
  @@map("group_invite")
}

enum GroupAuditAction {
  GROUP_CREATED
  GROUP_UPDATED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  ADMIN_TRANSFERRED
  INVITE_CREATED
  INVITE_REVOKED
  PLAN_CHANGED
  POST_REMOVED
  COMMENT_REMOVED
}

/// Record of sensitive group administration actions (PRD §7).
model GroupAuditEvent {
  id            String           @id @default(uuid(7)) @db.Uuid
  groupId       String           @db.Uuid
  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  action        GroupAuditAction
  actorId       String?
  actor         User?            @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectUserId String?
  subjectUser   User?            @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  metadata      Json?
  createdAt     DateTime         @default(now())

  @@index([groupId, createdAt])
  @@map("group_audit_event")
}

// ---------------------------------------------------------------------------------------------
// Problem catalog. Canonical problems are independent of roadmaps.
// ---------------------------------------------------------------------------------------------

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemSource {
  SEED
  CURATED
  USER
}

/// A canonical LeetCode problem. The URL is derived from the slug. Stores identifiers and
/// metadata only, never problem statements.
model Problem {
  id                 String              @id @default(uuid(7)) @db.Uuid
  /// Lowercase kebab-case (CHECK).
  leetcodeSlug       String              @unique
  title              String
  difficulty         Difficulty
  source             ProblemSource
  /// Requires a LeetCode subscription.
  premium            Boolean             @default(false)
  /// A free equivalent elsewhere, for premium problems (https only, at most 300 characters; CHECK).
  freeAlternativeUrl String?
  createdById        String?
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tags               ProblemTag[]
  roadmapItems       RoadmapItem[]
  completions        ProblemCompletion[]
  posts              Post[]
  submissions        Submission[]
  reviewAttempts     ReviewAttempt[]

  @@map("problem")
}

model Tag {
  id       String       @id @default(uuid(7)) @db.Uuid
  slug     String       @unique
  name     String
  problems ProblemTag[]

  @@map("tag")
}

model ProblemTag {
  problemId String  @db.Uuid
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tagId     String  @db.Uuid
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@index([tagId])
  @@map("problem_tag")
}

// ---------------------------------------------------------------------------------------------
// Roadmaps. Groups attach to an immutable published version, never to the live roadmap.
// ---------------------------------------------------------------------------------------------

enum RoadmapKind {
  CURATED
  CUSTOM
}

enum RoadmapVisibility {
  PRIVATE
  LINK
}

model Roadmap {
  id          String            @id @default(uuid(7)) @db.Uuid
  kind        RoadmapKind
  /// Stable identifier for curated roadmaps, used by the importer.
  slug        String?           @unique
  /// Null for curated roadmaps (CHECK); custom roadmaps keep working if the owner is deleted.
  ownerId     String?
  owner       User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// 1-80 characters (CHECK).
  title       String
  description String?
  visibility  RoadmapVisibility @default(PRIVATE)
  /// Random token for link sharing; present only while visibility is LINK.
  shareToken  String?           @unique
  /// Attribution for curated lists (where the problem mapping came from).
  sourceUrl   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    RoadmapVersion[]

  @@index([ownerId])
  @@map("roadmap")
}

/// A draft (publishedAt null, at most one per roadmap) or an immutable published snapshot.
/// Database triggers reject changes to a published version's sections and items.
model RoadmapVersion {
  id          String             @id @default(uuid(7)) @db.Uuid
  roadmapId   String             @db.Uuid
  roadmap     Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  number      Int
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  sections    RoadmapSection[]
  items       RoadmapItem[]
  plans       GroupRoadmapPlan[]

  @@unique([roadmapId, number])
  @@map("roadmap_version")
}

model RoadmapSection {
  id        String         @id @default(uuid(7)) @db.Uuid
  versionId String         @db.Uuid
  version   RoadmapVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  items     RoadmapItem[]

  @@unique([versionId, position])
  @@unique([id, versionId])
  @@map("roadmap_section")
}

model RoadmapItem {
  id          String             @id @default(uuid(7)) @db.Uuid
  versionId   String             @db.Uuid
  version     RoadmapVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sectionId   String             @db.Uuid
  /// Composite key keeps an item's section inside the same version.
  section     RoadmapSection     @relation(fields: [sectionId, versionId], references: [id, versionId], onDelete: Cascade)
  problemId   String             @db.Uuid
  problem     Problem            @relation(fields: [problemId], references: [id], onDelete: Restrict)
  position    Int
  assignments WeeklyAssignment[]

  @@unique([sectionId, position])
  @@unique([versionId, problemId])
  @@unique([id, versionId])
  @@index([problemId])
  @@map("roadmap_item")
}

// ---------------------------------------------------------------------------------------------
// Group plans and weekly assignments
// ---------------------------------------------------------------------------------------------

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum PlanPacing {
  PER_WEEK
  PER_SECTION
}

/// A group's schedule over one roadmap version. Week n runs from startDate + 7(n-1) days, in the
/// group's timezone. At most one ACTIVE plan per group (partial unique index).
model GroupRoadmapPlan {
  id               String             @id @default(uuid(7)) @db.Uuid
  groupId          String             @db.Uuid
  group            Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roadmapVersionId String             @db.Uuid
  roadmapVersion   RoadmapVersion     @relation(fields: [roadmapVersionId], references: [id], onDelete: Restrict)
  startDate        DateTime           @db.Date
  /// How assignments were generated; kept so a version upgrade can regenerate the same way.
  pacing           PlanPacing
  /// Set exactly when pacing is PER_WEEK, 1-50 (CHECK).
  problemsPerWeek  Int?
  status           PlanStatus         @default(ACTIVE)
  createdById      String?
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  archivedAt       DateTime?
  assignments      WeeklyAssignment[]
  posts            Post[]

  @@unique([id, roadmapVersionId])
  @@index([groupId])
  @@map("group_roadmap_plan")
}

/// Places one roadmap item in one week of a plan. The composite keys guarantee the item belongs
/// to the plan's roadmap version.
model WeeklyAssignment {
  planId        String           @db.Uuid
  versionId     String           @db.Uuid
  plan          GroupRoadmapPlan @relation(fields: [planId, versionId], references: [id, roadmapVersionId], onDelete: Cascade)
  roadmapItemId String           @db.Uuid
  roadmapItem   RoadmapItem      @relation(fields: [roadmapItemId, versionId], references: [id, versionId], onDelete: Restrict)
  /// 1-based (CHECK).
  weekNumber    Int

  @@id([planId, roadmapItemId])
  @@index([planId, weekNumber])
  @@map("weekly_assignment")
}

// ---------------------------------------------------------------------------------------------
// Progress. One canonical completion per user and problem, shared by every group and roadmap.
// ---------------------------------------------------------------------------------------------

enum CompletionSource {
  MANUAL
  EXTENSION
  IMPORT
}

model ProblemCompletion {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String           @db.Uuid
  problem     Problem          @relation(fields: [problemId], references: [id], onDelete: Restrict)
  source      CompletionSource
  completedAt DateTime
  /// Optional language the user solved it in (free text, at most 40 characters; CHECK).
  language    String?
  createdAt   DateTime         @default(now())
  review      ReviewSchedule?

  @@unique([userId, problemId])
  @@index([problemId])
  @@map("problem_completion")
}

// ---------------------------------------------------------------------------------------------
// Review. Private to the user, and separate from completion: a review never un-solves anything.
// ---------------------------------------------------------------------------------------------

/// Couldn't solve, struggled, solved, easy.
enum ReviewOutcome {
  AGAIN
  HARD
  GOOD
  EASY
}

/// When a solved problem next comes up for review. Exists exactly while the problem is solved:
/// it is created with the completion and the composite foreign key deletes it with the completion.
model ReviewSchedule {
  userId         String
  problemId      String            @db.Uuid
  completion     ProblemCompletion @relation(fields: [userId, problemId], references: [userId, problemId], onDelete: Cascade)
  /// The calendar date it is due, in the user's timezone.
  dueOn          DateTime          @db.Date
  /// The gap that led to dueOn, in days, 1-365 (CHECK).
  intervalDays   Int
  /// Growth factor in hundredths, 130-300 (CHECK).
  ease           Int
  reviewCount    Int               @default(0)
  lastReviewedAt DateTime?

  @@id([userId, problemId])
  @@index([userId, dueOn])
  @@map("review_schedule")
}

/// One review and how it went: the user's private history. Kept if the problem is later marked
/// unsolved.
model ReviewAttempt {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId    String        @db.Uuid
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  outcome      ReviewOutcome
  reviewedAt   DateTime
  /// The gap this review set, in days, 1-365 (CHECK).
  intervalDays Int

  @@index([userId, id])
  @@index([userId, problemId])
  @@map("review_attempt")
}

// ---------------------------------------------------------------------------------------------
// Social: posts in a group's feed. Every post belongs to exactly one group; feeds are the union
// of the viewer's groups. IDs are UUIDv7, so ordering by id is ordering by creation time.
// ---------------------------------------------------------------------------------------------

enum PostKind {
  /// Written by a member.
  TEXT
  /// Automatic: the author solved a problem the group's plan assigns (problemId).
  SOLVE
  /// Automatic: the author solved every problem in one week of a plan (planId, weekNumber).
  WEEK_DONE
  /// Automatic: the author solved every problem in a plan (planId).
  PLAN_DONE
}

/// Which columns each kind uses is enforced by CHECK constraints in the migration, and each
/// automatic post exists at most once per author (partial unique indexes).
model Post {
  id          String            @id @default(uuid(7)) @db.Uuid
  groupId     String            @db.Uuid
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind        PostKind          @default(TEXT)
  /// Markdown source, 1-5000 characters, for TEXT posts only (CHECK). Rendered without raw HTML.
  body        String?
  /// The problem the post is about, if any; the solved problem for SOLVE.
  problemId   String?           @db.Uuid
  problem     Problem?          @relation(fields: [problemId], references: [id], onDelete: Restrict)
  /// The plan a milestone belongs to; always a plan of the post's own group (trigger).
  planId      String?           @db.Uuid
  plan        GroupRoadmapPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// The finished week, for WEEK_DONE (1-based).
  weekNumber  Int?
  /// The author marked the post as containing spoilers: its code blocks render folded.
  spoiler     Boolean           @default(false)
  createdAt   DateTime          @default(now())
  editedAt    DateTime?
  /// The author hid this automatic post. It stays hidden and is never posted again.
  hiddenAt    DateTime?
  /// The solve behind this automatic post was undone. Cleared if it is redone with sharing on.
  withdrawnAt DateTime?
  reactions   Reaction[]
  comments    Comment[]

  @@index([groupId, id(sort: Desc)])
  @@index([authorId, createdAt])
  @@index([problemId])
  @@map("post")
}

/// The fixed set of reactions: kudos, impressive, helpful, same here.
enum ReactionKind {
  KUDOS
  IMPRESSIVE
  HELPFUL
  SAME_HERE
}

/// One person's reaction of one kind to one post; toggling it off deletes the row.
model Reaction {
  postId    String       @db.Uuid
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReactionKind
  createdAt DateTime     @default(now())

  @@id([postId, userId, kind])
  @@index([userId])
  @@map("reaction")
}

/// A comment on a post, or a reply to one (two levels: a reply's parent is always a top-level
/// comment on the same post, enforced by a trigger).
model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  postId    String    @db.Uuid
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?   @db.Uuid
  parent    Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Replies")
  /// Markdown, 1-2000 characters (CHECK).
  body      String
  /// Code blocks render folded, as on posts.
  spoiler   Boolean   @default(false)
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([postId, parentId, id])
  @@index([parentId, id])
  @@index([authorId, createdAt])
  @@map("comment")
}

// ---------------------------------------------------------------------------------------------
// LeetCode extension (Phase 3)
// ---------------------------------------------------------------------------------------------

/// A browser extension the user connected. The token is shown once; only its SHA-256 is kept.
model ExtensionConnection {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hex SHA-256 of the bearer token (64 characters; CHECK).
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  /// Set when the user disconnects it; the token stops working at once.
  revokedAt  DateTime?

  @@index([userId])
  @@map("extension_connection")
}

enum SubmissionSource {
  EXTENSION
}

/// An accepted LeetCode submission the extension synced. Private to its author: never shown to
/// groups. Counts as a completion once its problem is in the catalog; until then `problemId` is
/// null, and an unmatched submission is deleted 30 days after it arrived.
model Submission {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      SubmissionSource
  /// LeetCode's submission ID (digits; CHECK). Unique per user and source, so retries are no-ops.
  externalId  String
  /// LeetCode problem slug, as on Problem (CHECK).
  problemSlug String
  problemId   String?          @db.Uuid
  problem     Problem?         @relation(fields: [problemId], references: [id], onDelete: SetNull)
  /// LeetCode's language slug, e.g. python3 (1-40 characters; CHECK).
  language    String
  /// The solution, 1-100000 characters (CHECK). Kept until the user deletes the submission.
  code        String
  /// When LeetCode judged it.
  submittedAt DateTime
  receivedAt  DateTime         @default(now())

  @@unique([userId, source, externalId])
  @@index([userId, receivedAt])
  @@index([problemSlug])
  @@map("submission")
}
